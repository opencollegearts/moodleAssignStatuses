{{!
    @template block_assignstatuses/assignments_list

    List of course assignments with submission and grading status icons.

    Context variables required for this template:
    * hasassignments - whether any assignments are visible
    * assignments - array of assignment rows
    * noassignments - empty-state message
    * headerassignment / headersubmission / headergrading - column labels

    Example context (json):
    {
        "hasassignments": true,
        "noassignments": "There are no assignments in this course.",
        "headerassignment": "Assignment",
        "headersubmission": "Submission",
        "headergrading": "Grading",
        "assignments": [
            {
                "name": "Essay 1",
                "url": "https://example.com/mod/assign/view.php?id=1",
                "submissionicon": "i/submitted",
                "submissioncomponent": "block_assignstatuses",
                "submissionlabel": "Submitted for grading",
                "submissionclass": "block-assignstatuses-status-submitted",
                "haslate": false,
                "gradingicon": "i/notgraded",
                "gradingcomponent": "block_assignstatuses",
                "gradinglabel": "Not graded",
                "gradingclass": "block-assignstatuses-status-notgraded"
            }
        ]
    }
}}
<div class="block-assignstatuses">
    {{#hasassignments}}
        <ul class="block-assignstatuses-list list-unstyled mb-0">
            {{#assignments}}
                <li class="block-assignstatuses-item">
                    <a class="block-assignstatuses-name" href="{{url}}">{{{name}}}</a>
                    <div class="block-assignstatuses-statuses" role="group" aria-label="{{name}}">
                        <span class="block-assignstatuses-status {{submissionclass}}"
                              title="{{headersubmission}}: {{submissionlabel}}">
                            {{#pix}}{{submissionicon}}, {{submissioncomponent}}, {{submissionlabel}}{{/pix}}
                            <span class="sr-only">{{headersubmission}}: {{submissionlabel}}</span>
                            {{#haslate}}
                                <span class="block-assignstatuses-late" title="{{latelabel}}">
                                    {{#pix}}{{lateicon}}, {{latecomponent}}, {{latelabel}}{{/pix}}
                                    <span class="sr-only">{{latelabel}}</span>
                                </span>
                            {{/haslate}}
                        </span>
                        <span class="block-assignstatuses-status {{gradingclass}}"
                              title="{{headergrading}}: {{gradinglabel}}">
                            {{#pix}}{{gradingicon}}, {{gradingcomponent}}, {{gradinglabel}}{{/pix}}
                            <span class="sr-only">{{headergrading}}: {{gradinglabel}}</span>
                        </span>
                    </div>
                </li>
            {{/assignments}}
        </ul>
    {{/hasassignments}}
    {{^hasassignments}}
        <p class="block-assignstatuses-empty mb-0">{{noassignments}}</p>
    {{/hasassignments}}
</div>
